        <mxCell id="lTx8bPfyAKymljQ4wB-i-12" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;2-3 Mois&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontColor=#FF0000;fontStyle=2" parent="1" vertex="1">
