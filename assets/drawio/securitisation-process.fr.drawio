<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.17 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36" version="24.7.17">
  <diagram name="Page-1" id="4UAvBW2fsN4aboKgwd01">
    <mxGraphModel dx="593" dy="535" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lTx8bPfyAKymljQ4wB-i-1" value="Préparation" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#C4DEFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="120" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-2" value="&amp;nbsp; &amp;nbsp; Sélection de l&#39;arrangeur" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#8599FF;" parent="1" vertex="1">
          <mxGeometry x="230" y="120" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-3" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#ffffff&quot;&gt;&amp;nbsp; &amp;nbsp; Exécution de la t&lt;/font&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-size: 12px;&quot;&gt;ransaction&lt;/span&gt;&lt;/font&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;align=center;fillColor=#6D78B0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="440" y="120" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-4" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Collection de données&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Examen de la documentation de la dette en cours à la recherche de clauses pouvant potentiellement restreindre l&#39;utilisation de la titrisation&lt;br&gt;• Examen du modèle économique&lt;br&gt;• Analyse des actifs (créances, loyers, valeur résiduelle...), des statistiques de créances douteuses et de dilution, de la concentration des clients&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C4DEFF;align=left;fillColor=none;spacing=5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="180" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-7" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Livrables&lt;/u&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Est. du montant du financement&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Demandes de propositions (RFP)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C4DEFF;align=left;fillColor=none;arcSize=30;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="380" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-8" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;RFP&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Sélection des destinataires de la RFP&lt;br&gt;• Lancement de la RFP&lt;br&gt;• Examen des réponses à la RFP et sélection de l&#39;arrangeur&lt;br&gt;• Négociation des principales caractéristiques de la transaction avec les banques, y compris le prix, la commission d&#39;engagement, le montant, la période de renouvellement, etc.&lt;br&gt;• Sélection d&#39;un conseiller juridique&lt;br&gt;• Rédaction du Term Sheet (avec le support juridique) et des Mandats&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8599FF;align=left;fillColor=none;spacingLeft=0;spacingRight=0;spacing=5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="230" y="180" width="190" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-9" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Livrables&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Présentation des résultats de la RFP&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Term Sheet et mandat(s) signés&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8599FF;align=left;fillColor=none;arcSize=29;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="230" y="380" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-10" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;Support à l&#39;exécution de la transaction (durant cette phase, l&#39;arrangeur prend la tête)&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;La phase d&#39;exécution comprend :&lt;br&gt;• Structuration de la transaction&lt;br&gt;• Contrats avec les prestataires de services : par exemple, conseiller juridique de la banque, auditeur, société de gestion, dépositaire, certificateur STS, servicer de secours&lt;br&gt;• Due diligence&lt;br&gt;• Rédaction de la documentation de la transaction&lt;br&gt;• Si nécessaire, notation de la transaction par une agence de notation, ou certification STS&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#525DFF;align=left;fillColor=none;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="440" y="180" width="180" height="270" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-11" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;2-3 Mois&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontColor=#FF0000;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="95" y="90" width="60" height="30" as="geometry" />
