          <mxGeometry x="160" y="80" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="WIyWlLk6GJQsqaUBKTNV-7" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Securitisation Special Purpose Entity - SSPE)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="320" y="80" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-0" value="Investors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="480" y="80" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-4" value="&lt;p style=&quot;line-height: 97%; padding-left: 3px; margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;div style=&quot;font-size: 9px; line-height: 100%; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;• The securitised portfolio generally includes homogeneous assets, such as trade receivables, operational leasing contracts, inventories or loans.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; line-height: 100%; padding-left: 3px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; line-height: 100%; padding-left: 3px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• The portfolio can include assets in multiple countries&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;align=left;perimeterSpacing=1;glass=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="160" y="130" width="120" height="130" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-5" value="&lt;div style=&quot;font-size: 9px; padding-left: 3px; padding-right: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;•&lt;/font&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;Assets are transferred from the originator to the issuing entity.&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• The SSPE is bankruptcy remote.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px; margin-right: 0px; margin-left: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;• In many jurisdictions, the originator must retain some economic exposure to the underlying assets.&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;align=left;perimeterSpacing=1;glass=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="320" y="130" width="120" height="130" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-6" value="&lt;p style=&quot;line-height: 101%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;The SSPE issues tranched Asset Backed Securities to investors. The junior tranche is bought by the originator.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;align=left;perimeterSpacing=1;glass=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="480" y="130" width="120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-7" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;Senior Tranche&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;gradientColor=#ea6b66;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
