        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-8" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Mezzanine Tranche(s)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;gradientColor=#d5739d;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
