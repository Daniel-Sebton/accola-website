        <mxCell id="WIyWlLk6GJQsqaUBKTNV-7" value="Entité de Titrisation&lt;div style=&quot;font-size: 9px;&quot;&gt;(Securitisation Special Purpose Entity - SSPE)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="320" y="80" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-0" value="Investisseurs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;glass=0;strokeWidth=1;shadow=0;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="480" y="80" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-5" value="&lt;div style=&quot;font-size: 9px; padding-left: 3px; padding-right: 3px;&quot;&gt;• Les actifs sont transférés de l&#39;originateur à l&#39;entité de titrisation.&lt;br&gt;• Le SSPE est protégé contre la faillite de l&#39;originateur.&lt;br&gt;• Dans de nombreuses juridictions, l&#39;originateur doit conserver une exposition économique aux actifs sous-jacents.&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;align=left;perimeterSpacing=1;glass=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="320" y="130" width="120" height="160" as="geometry" />
        </mxCell>
        <mxCell id="-b0-G9f6dBbCSlMZtaws-6" value="&lt;p style=&quot;line-height: 101%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Le SSPE émet des titres structurés en tranches de niveau de risque variable. La tranche junior&amp;nbsp; est achetée par l&#39;originateur.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 101%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 113%; margin-bottom: 0px; margin-top: 0px; padding-right: 3px; padding-left: 3px;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;align=left;perimeterSpacing=1;glass=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="480" y="130" width="120" height="160" as="geometry" />
        </mxCell>
