        <mxCell id="lTx8bPfyAKymljQ4wB-i-3" value="&lt;font color=&quot;#ffffff&quot;&gt;&amp;nbsp; &amp;nbsp;Transaction Execution&lt;/font&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;align=center;fillColor=#6D78B0;" parent="1" vertex="1">
          <mxGeometry x="440" y="120" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-4" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Data Collection&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Review of outstanding debt documentation in search of clauses potentially restricting the use of securitisation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Business model review&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• Analysis of assets (receivable, rents, residual value...), delinquency and dilution statistics, client concentration&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C4DEFF;align=left;fillColor=none;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="80" y="180" width="160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-7" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Deliverables&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Estimate of funding quantum&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Request for Proposals&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C4DEFF;align=left;fillColor=none;arcSize=30;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="80" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-8" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;RFP&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Selection of RFP recipients&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• RFP Launch&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• RFP response review and arranger selection&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Negotiation of main transaction characteristics with banks including price, commitment fee, quantum, revolving period etc.&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Selection of a legal advisor&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Drafting of Term Sheet (with legal support) and Mandate(s)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8599FF;align=left;fillColor=none;spacingLeft=0;spacingRight=0;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="260" y="180" width="160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-9" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;u&gt;Deliverables&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• RFP findings presentation&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Term Sheet and mandate(s) signed&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8599FF;align=left;fillColor=none;arcSize=29;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="260" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-10" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Support to transaction execution execution (during this phase, the arranger takes the lead)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The execution phase includes:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Transaction Structuring&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;• Contracting with service providers: for instance bank legal advisor, auditor, management company, depositary, STS certifier, back-up servicer&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• Due Diligence&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• Drafting of transaction documentation&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;• If needed, transaction rating by a rating agency, or STS certification&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#525DFF;align=left;fillColor=none;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="440" y="180" width="160" height="270" as="geometry" />
        </mxCell>
        <mxCell id="lTx8bPfyAKymljQ4wB-i-11" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;2-3 Months&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontColor=#FF0000;fontStyle=2" parent="1" vertex="1">
