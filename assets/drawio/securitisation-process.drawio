        <mxCell id="lTx8bPfyAKymljQ4wB-i-2" value="Arranger Selection" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#8599FF;" parent="1" vertex="1">
          <mxGeometry x="260" y="120" width="160" height="40" as="geometry" />
