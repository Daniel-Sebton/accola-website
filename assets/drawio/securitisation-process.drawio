        <mxCell id="lTx8bPfyAKymljQ4wB-i-1" value="Preparation" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#C4DEFF;" parent="1" vertex="1">
